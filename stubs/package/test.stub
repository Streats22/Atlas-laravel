<?php

declare(strict_types=1);

namespace {{ namespace }}\Tests;

use Atlas\AtlasServiceProvider;
use Atlas\Packaging\BundleArchive;
use Atlas\Packaging\BundleImporter;
use Atlas\Packaging\MediaUrls;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Orchestra\Testbench\TestCase;
use {{ namespace }}\{{ class }}ServiceProvider;

class PackageTest extends TestCase
{
    use RefreshDatabase;

    protected function getPackageProviders($app): array
    {
        return [AtlasServiceProvider::class, {{ class }}ServiceProvider::class];
    }

    public function test_every_shipped_block_is_registered(): void
    {
        foreach (glob(__DIR__ . '/../src/Blocks/*.php') ?: [] as $file) {
            $class = '{{ namespace }}\\Blocks\\' . basename($file, '.php');
            $this->assertTrue(app(\Atlas\Atlas::class)->blocks()->has((new $class())->type()));
        }
    }

    public function test_the_bundle_imports_cleanly(): void
    {
        if (! {{ class }}ServiceProvider::HAS_BUNDLE) {
            $this->markTestSkipped('This package ships no bundle.');
        }

        [$bundle, $media] = (new BundleArchive(MediaUrls::fromConfig()))->read({{ class }}ServiceProvider::bundlePath());
        $result = app(BundleImporter::class)->import($bundle, $media);

        $this->assertSame(count($bundle->pages), $result->pagesCreated);
    }
}
